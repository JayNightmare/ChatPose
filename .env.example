NODE_ENV=development
APP_NAME=ChatPose
SQL_DIALECT=mysql
P2P_LISTEN_PORT=0
P2P_TOPIC=chatpose/secure-session/1.0.0
SIGNAL_BOOTSTRAP=
SQL_SERVER=your-host
SQL_DATABASE=chatpose
SQL_USER=your-user
SQL_PASSWORD=replace-me
SQL_PORT=3306
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERT=false
SQL_SSL=false
SQL_SSL_REJECT_UNAUTHORIZED=true
SQL_SSL_CA_FILE=
SQL_SSL_CERT_FILE=
SQL_SSL_KEY_FILE=
EMAIL_CHECK_MODE=warn
APP_MASTER_SECRET=replace-with-64-char-random-secret
